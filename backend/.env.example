# CAT Intelligence 2026 — Environment Configuration
# NEVER commit real credentials to source control.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cat2026
# For local testing without Postgres, sqlite can be used:
# DATABASE_URL=sqlite+aiosqlite:///./cat2026.db

# Master AES-256-GCM encryption key (Base64-encoded 32 bytes)
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=

# JWT Secret for access token signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev_secret_key_change_in_production_min_32_chars

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_EXPIRE_MINUTES=120
MAX_UPLOAD_SIZE_MB=50

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# Optional Supabase storage configuration
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
